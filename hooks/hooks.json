{
  "description": "Codex Tower local task lifecycle tracking.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "PermissionRequest": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "PostToolUse": [{"matcher": "^update_plan$", "hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "node \"$PLUGIN_ROOT/hooks/task-event.mjs\"", "timeout": 3}]}]
  }
}
